//week07-1 好玩的程式設計 黑白棋
size(620, 620); //視窗大小 600+20 x 600+20
background(245, 216, 142);
for (int i=0; i<10; i++) { //左手 i (代表列)
  for (int j=0; j<10; j++) { //右手 j (代表行)
    int x = 10 + j * 60, y = 10 + i * 60;
    fill(245, 216, 142); //格子的填充顏色
    strokeWeight(2); //線條粗細 2
    rect(x, y, 60, 60); //繪製每個格子 60x60
  }
}
